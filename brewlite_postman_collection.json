    {
      "name": "07. Concurrency - Tranh chấp tồn kho",
      "item": [
        {
          "name": "Bắn đồng thời 2 khách mua cùng lúc (Race Condition Test)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Bắn đồng thời một khách B đặt mua cùng món",
                  "const concurrentOrder = {",
                  "    userId: 2,",
                  "    items: [",
                  "        {",
                  "            productId: Number(pm.collectionVariables.get(\"selectedProductId\") || 1),",
                  "            size: \"M\",",
                  "            quantity: 1",
                  "        }",
                  "    ]",
                  "};",
                  "",
                  "console.log(\"🚀 Bắn Người B đồng thời với Người A...\");",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrl\") + \"/orders\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: { mode: \"raw\", raw: JSON.stringify(concurrentOrder) }",
                  "}, function (err, res) {",
                  "    console.log(\"===> KẾT QUẢ NGƯỜI B (Gửi song song):\");",
                  "    console.log(\"Status Code:\", res.code);",
                  "    console.log(\"Phản hồi:\", res.json());",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Người A đặt hàng thành công\", function () {",
                  "    pm.expect([201, 400]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    {\n      \"productId\": {{selectedProductId}},\n      \"size\": \"M\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        }
      ]
    }
