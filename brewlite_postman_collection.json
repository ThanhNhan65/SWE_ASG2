    {
      "name": "04. Đặt hàng (Orders)",
      "item": [
        {
          "name": "04.1. Đặt hàng thành công (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo đơn thành công (201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var order = pm.response.json();",
                  "    pm.expect(order).to.have.property(\"id\");",
                  "    pm.expect(order.status).to.eql(\"PENDING\");",
                  "    // Tự động lưu mã đơn sang bước thanh toán",
                  "    pm.collectionVariables.set(\"currentOrderId\", order.id);",
                  "    pm.collectionVariables.set(\"currentOrderCode\", order.orderCode || order.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"items\": [\n    {\n      \"productId\": {{selectedProductId}},\n      \"size\": \"M\",\n      \"sweetness\": \"100%\",\n      \"ice\": \"Bình thường\",\n      \"quantity\": 1\n    }\n  ]\n}"
