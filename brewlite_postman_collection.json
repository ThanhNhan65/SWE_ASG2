    {
      "name": "05. Thanh toán (Payments)",
      "item": [
        {
          "name": "05.1. Thanh toán thành công bằng Ví WALLET (Happy Path)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Tự động sinh Idempotency Key duy nhất cho lần thanh toán này",
                  "pm.collectionVariables.set(\"paymentIdempotencyKey\", \"PAY-\" + Date.now() + \"-\" + Math.floor(Math.random() * 1000));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Thanh toán xử lý thành công (201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.orderStatus).to.eql(\"PAID\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{currentOrderId}},\n  \"method\": \"WALLET\",\n  \"idempotencyKey\": \"{{paymentIdempotencyKey}}\",\n  \"mockSuccess\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
          }
        },
        {
          "name": "05.2. Lỗi thiếu IdempotencyKey (Validation 400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
