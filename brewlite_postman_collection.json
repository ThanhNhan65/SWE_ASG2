            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{currentOrderId}},\n  \"method\": \"WALLET\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
