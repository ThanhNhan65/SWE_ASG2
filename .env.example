# App Configuration
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://brewlite_user:brewlite_password@localhost:5432/brewlite_db
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite_db

# JWT Secrets
JWT_SECRET=your-secret-key

# Client / API URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api
