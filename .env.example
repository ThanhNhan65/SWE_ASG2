# App Configuration
NODE_ENV=development
PORT=3001

# Backend & Database (Local PostgreSQL / Docker Compose / Neon Serverless Postgres)
DATABASE_URL="postgresql://brewlite_user:brewlite_password@localhost:5432/brewlite_db?schema=public"
DATABASE_URL_UNPOOLED="postgresql://brewlite_user:brewlite_password@localhost:5432/brewlite_db?schema=public"
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite_db

# JWT Authentication Secret
JWT_SECRET="your-jwt-secret-key"

# Payment Gateways (Sandbox)
ZALOPAY_APP_ID=2554
ZALOPAY_KEY1="your-zalopay-key1"
ZALOPAY_KEY2="your-zalopay-key2"
ZALOPAY_CREATE_URL="https://sb-openapi.zalopay.vn/v2/create"
ZALOPAY_QUERY_URL="https://sb-openapi.zalopay.vn/v2/query"
ZALOPAY_RETURN_URL="http://localhost:3000/orders/zalopay-return"

VNPAY_TMN_CODE="8O0IA3FA"
VNPAY_HASH_SECRET="your-vnpay-hash-secret"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/orders/vnpay-return"

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
